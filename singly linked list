class Music():
    def __init__(self,data):
        self.data=data
        self.next=None
class PlayList():
    def __init__(self):
        self.head=None
    def is_empty(self):
            return self.head is None
    def append(self,data):
        new_song=Music(data)
        if self.head is None:
            self.head=new_song
            return
        current=self.head
        while current.next:
            current=current.next
        current.next=new_song
    def prepend(self,data):
        new_song=Music(data)
        new_song.next=self.head
        self.head=new_song
    def display(self):
        current=self.head
        while current:
            print(current.data,end="->")
            current=current.next
        print("None")
