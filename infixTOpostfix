operator=set(['+','-','(',')','*','/','^'])
presidence={'+':1,'-':1,'*':2,'/':2,'^':3}

def infixToPostfix(expression):
    stack=[]
    output=""
    for ch in expression: 
        if ch not in operator:
            output += ch
        elif ch=='(':
            stack.append('(')
        elif ch==')':
            while stack and  stack[-1]!='(':
                output +=stack.pop()
            stack.pop()
        else:
            while stack and stack[-1]!='(' and presidence[ch]<=presidence[stack[-1]]:
                output +=stack.pop()
            stack.append(ch)
    while stack:
        output +=stack.pop()
    return output
expression=input("enter infix expression: ")
result=infixToPostfix(expression)
print(f"Result :{result}")
