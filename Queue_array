class Queue:
    def __init__(self):
        self.max=10
        self.front=-1
        self.rear=-1
        self.queue=[]
    def enqueue(self,data):
        if self.max>=self.rear:
            self.queue.append(data)
            self.rear+=1
            self.front=0
        elif self.max>=self.rear:
            self.queue.append(data)
            self.rear+=1
        else:
            print("Queue is full")
    def dequeue(self):
        if self.rear==0:
            print("Queue is empty")
            return
        else:
            print(f"{self.queue[self.front]} is removed")
            self.front+=1
        if self.rear==self.front:
            self.rear=self.front=-1
    def display_all(self):
        st=self.front
        ed=self.rear
        for i in range(st,ed+1):
            print(f"{self.queue[i]}-->",end="")
        print(None)
obj=Queue()
n=int(input("Enter no of elements:"))
for i in range(n):
    a=int(input(f"Enter element{i+1}:"))
    obj.enqueue(a)
obj.display_all()
obj.dequeue()
obj.dequeue()
obj.dequeue()
obj.display_all()
