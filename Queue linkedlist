class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

class Stack:
    def __init__(self):
        self.top = None

    def is_empty(self):
        return self.top is None

    def push(self, data):
        new_node = Node(data)
        new_node.next = self.top
        self.top = new_node
        print(f"{data} is pushed")

    def pop(self):
        if self.is_empty():
            return None
        popped_data = self.top.data
        self.top = self.top.next
        return popped_data

s = Stack()
n = int(input("Enter no of car to park: "))

for i in range(n):
    p = input(f"Enter car {i+1} to park: ")
    s.push(p)

print("car takeout:", s.pop())
